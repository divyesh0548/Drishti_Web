generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Firm {
  id          String   @id @default(cuid())
  name        String
  brandColor  String?
  users       User[]
  clients     Client[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id          String    @id @default(cuid())
  firmId      String
  firm        Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  name        String
  email       String    @unique
  role        UserRole
  isActive    Boolean   @default(true)
  tasks       WorkflowTask[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Client {
  id             String         @id @default(cuid())
  firmId         String
  firm           Firm           @relation(fields: [firmId], references: [id], onDelete: Cascade)
  companyName    String
  pan            String
  cin            String?
  gst            String?
  industry       String
  entityType     String
  financialYear  String
  currency       String
  status         WorkStatus
  imports        TrialBalanceImport[]
  statements     StatementPack[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model TrialBalanceImport {
  id             String       @id @default(cuid())
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sourceSystem   String
  fileName       String
  importedById   String?
  importedBy     User?        @relation(fields: [importedById], references: [id])
  status         ImportStatus
  ledgers        Ledger[]
  importedAt     DateTime     @default(now())
}

model Ledger {
  id              String             @id @default(cuid())
  importId        String
  trialBalance    TrialBalanceImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  code            String
  name            String
  debit           Decimal            @db.Decimal(18, 2)
  credit          Decimal            @db.Decimal(18, 2)
  netBalance      Decimal            @db.Decimal(18, 2)
  mappingHead     String?
  noteNumber      String?
  confidence      Decimal?           @db.Decimal(5, 2)
}

model StatementPack {
  id            String      @id @default(cuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  version       Int
  framework     String
  generatedById String?
  generatedBy   User?       @relation(fields: [generatedById], references: [id])
  status        WorkStatus
  generatedAt   DateTime    @default(now())
}

model WorkflowTask {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  clientName   String
  status       WorkStatus
  dueDate      DateTime
  createdAt    DateTime    @default(now())
}

enum UserRole {
  SUPER_ADMIN
  FIRM_ADMIN
  MANAGER
  ARTICLE
  AUDITOR
  CLIENT
  READ_ONLY
}

enum ImportStatus {
  QUEUED
  VALIDATING
  IMPORTED
  FAILED
}

enum WorkStatus {
  PENDING
  IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
}

